# CryptoMaster V10.13u+21 — Paper Training Mode + Live Readiness Configuration
# Copy this file to .env and adjust for your deployment

# ════════════════════════════════════════════════════════════════════════════
# TRADING MODE (CRITICAL)
# ════════════════════════════════════════════════════════════════════════════
# Options: paper_live (conservative), paper_train (active learning), replay_train, live_real
# Default: paper_live (safe, no real orders)
# paper_train: Active sampler opens paper trades for learning (real prices, no real orders)
TRADING_MODE=paper_train

# ════════════════════════════════════════════════════════════════════════════
# LIVE ORDER PROTECTION (CRITICAL)
# ════════════════════════════════════════════════════════════════════════════
# Enable real orders to Binance exchange
# Default: false (no real orders placed)
ENABLE_REAL_ORDERS=false

# Explicit confirmation required to enable live trading
# MUST be true AND TRADING_MODE=live_real AND ENABLE_REAL_ORDERS=true
# Default: false (requires manual override)
LIVE_TRADING_CONFIRMED=false

# ════════════════════════════════════════════════════════════════════════════
# PAPER TRADING & EXPLORATION
# ════════════════════════════════════════════════════════════════════════════
# Enable controlled paper exploration (weak rejects, negative EV probes)
# Only applies in paper_live and replay_train modes
# Default: true (learning through exploration)
PAPER_EXPLORATION_ENABLED=true

# Paper exploration profile: conservative, balanced, aggressive_training
# Default: balanced (moderate exploration, learning-friendly)
PAPER_EXPLORATION_PROFILE=balanced

# ════════════════════════════════════════════════════════════════════════════
# PAPER TRAINING SAMPLER (P1.1k — Active Learning)
# ════════════════════════════════════════════════════════════════════════════
# Enable active paper training sampler (only in paper_train mode)
# Default: true (actively sample rejected signals for learning)
PAPER_TRAINING_ENABLED=true

# Minimum paper entries per hour target
# Default: 6 (need enough samples for learning)
PAPER_TRAINING_MIN_ENTRIES_PER_HOUR=6

# Maximum open paper training positions
# Default: 5 (safety cap)
PAPER_TRAINING_MAX_OPEN=5

# Maximum paper training positions per symbol
# Default: 1 (avoid over-concentration)
PAPER_TRAINING_MAX_PER_SYMBOL=1

# Maximum hold time for paper training trades (seconds)
# Default: 300 (5 minutes, learning-focused not hold)
PAPER_TRAINING_MAX_HOLD_S=300

# Allow C_WEAK_EV_TRAIN bucket (weak but positive EV)
# Default: true (learn about weak signals)
PAPER_TRAINING_ALLOW_WEAK_EV=true

# Allow D_NEG_EV_CONTROL bucket (learn what bad looks like)
# Default: true (control baseline essential)
PAPER_TRAINING_ALLOW_NEG_EV_CONTROL=true

# Allow E_NO_PATTERN_BASELINE bucket (no pattern with inferred side)
# Default: true (baseline for pattern detection)
PAPER_TRAINING_ALLOW_NO_PATTERN=true

# ════════════════════════════════════════════════════════════════════════════
# FIREBASE & DATA
# ════════════════════════════════════════════════════════════════════════════
# Firebase project ID
FIREBASE_PROJECT_ID=cryptomaster-live-v10

# Firebase database URL (default Firestore)
FIREBASE_DATABASE_URL=https://cryptomaster-live-v10.firebaseio.com

# Write closed trades to Firebase (paper mode)
# Default: true (learning updates enabled)
FIREBASE_TRADES_WRITE=true

# ════════════════════════════════════════════════════════════════════════════
# EXCHANGE SETTINGS
# ════════════════════════════════════════════════════════════════════════════
# Binance API key (required for real orders)
BINANCE_API_KEY=

# Binance API secret (required for real orders)
BINANCE_API_SECRET=

# Testnet mode (for live_real testing without real money)
BINANCE_USE_TESTNET=false

# ════════════════════════════════════════════════════════════════════════════
# SAFETY & LIMITS
# ════════════════════════════════════════════════════════════════════════════
# Maximum position value in USD (per trade)
MAX_POSITION_USD=500

# Maximum daily loss in USD (kill switch)
MAX_DAILY_LOSS_USD=1000

# Maximum open positions
MAX_OPEN_POSITIONS=5

# ════════════════════════════════════════════════════════════════════════════
# LOGGING & DIAGNOSTICS
# ════════════════════════════════════════════════════════════════════════════
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable verbose diagnostics
VERBOSE_LOGGING=false

# ════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT
# ════════════════════════════════════════════════════════════════════════════
# Environment: development, staging, production
ENVIRONMENT=development

# Enable dashboard/metrics export
ENABLE_DASHBOARD=true

# ════════════════════════════════════════════════════════════════════════════
# P0.8+ EVIDENCE-FIRST STRATEGY PIPELINE (Evidence-First Strategy Expansion v2)
# ════════════════════════════════════════════════════════════════════════════
# The new cost-aware strategy pipeline (trend_cost_aware_v1,
# volatility_breakout_v1, sideways_mean_reversion_v1, funding_observer_v1 --
# src/services/strategy_*.py) is a SEPARATE admission path from the legacy
# signal_generator.py one. Every strategy here registers evidence_only=True
# (src/services/strategy_registry.py) -- it can never receive strict-EV/
# scaled admission, only the same bounded evidence-collection path this
# whole file's exploration settings already govern for the legacy path.
# 2026-08-18: NOT all of these are wired the same way -- see the phase
# acceptance reports (docs/P0_7_ACCEPTANCE.md .. docs/P1_0_ACCEPTANCE.md,
# docs/P1_1_P1_3_PHASE_REPORT.md) for exactly what each flag currently does.

# Shadow evaluator (src/services/p0_8_plus_shadow_evaluator.py): periodic
# candle fetch + regime classify + candidate generation + central router
# evaluation, LOGS ONLY -- structurally cannot open a position (bypass-
# tested). Safe to leave on; default true.
PAPER_P0_8_PLUS_SHADOW_ENABLED=true

# Live pipeline (src/services/p0_8_plus_live_pipeline.py): reuses the
# shadow evaluator's own evaluate_symbol() -- for an admitted candidate
# backed by a REAL (not synthetic) live quote, opens a real bounded
# evidence-collection paper position (P0_8_PLUS_EVIDENCE_COLLECTION
# bucket). Ships opt-in (default false) -- deliberately NOT the same
# default as the shadow evaluator, since this one can spend paper capital.
# Full trading-safety-agent + reviewer-agent review before flipping true
# in production; see _workspace/33_p0_8_plus_live_wiring.md.
PAPER_P0_8_PLUS_LIVE_ENABLED=false

# Comma-separated symbol override for both the shadow evaluator and the
# live pipeline. Empty = use the deployment's full trading symbol list.
PAPER_P0_8_PLUS_SYMBOLS=

# Synthetic bid/ask half-spread (bps) used ONLY when no real live quote
# is available yet (e.g. immediately at startup) -- shadow logging only,
# the live pipeline never opens a position on a synthetic quote.
PAPER_P0_8_PLUS_SYNTHETIC_SPREAD_BPS=3.0

# How stale (ms) a candle's market_data_event_time_ms may be before the
# central router rejects it as REJECT_STALE_MARKET_DATA. Sized for a
# 1-minute REST-polled candle (can legitimately be up to ~60s "old" and
# still be the correct, current bar), not a live tick feed's tighter
# default (signal_router.DEFAULT_MAX_DATA_AGE_MS=5000ms).
PAPER_P0_8_PLUS_MAX_DATA_AGE_MS=90000

# How old (s) a cached live quote (src/services/live_quote_cache_v1.py,
# an event_bus subscriber on market_stream.py's price_tick) may be and
# still be trusted over the synthetic fallback above.
PAPER_P0_8_PLUS_QUOTE_MAX_AGE_S=30.0

# Symbol blacklist (comma-separated) -- 2026-07-09 forward-test finding
# that some symbols have anti-edge on the mean-reversion signal. Enforced
# at the open_paper_position() choke itself (2026-08-18 fix -- previously
# only enforced in the legacy signal_generator.py entry point, meaning
# any caller reaching open_paper_position() directly never saw it), so
# this single flag governs both the legacy path and the P0.8+ pipeline.
PAPER_SYMBOL_BLACKLIST=

# Firebase daily quota ceilings (free-tier defaults; see
# _workspace/34_quota_read_write_conflation.md for how a write-only
# breach is now correctly kept from also blocking reads).
FIREBASE_QUOTA_MAX_READS=50000
FIREBASE_QUOTA_MAX_WRITES=20000

# ════════════════════════════════════════════════════════════════════════════
# IMPORTANT NOTES
# ════════════════════════════════════════════════════════════════════════════
# ✅ SAFE DEFAULTS: This configuration places NO real orders by default
# ✅ PAPER MODE: All trades simulated with real live/historical prices
# ✅ EXPLORATION: Controlled learning through weak-reject overrides
#
# ⚠️  TO ENABLE LIVE TRADING:
#    1. Set TRADING_MODE=live_real
#    2. Set ENABLE_REAL_ORDERS=true
#    3. Set LIVE_TRADING_CONFIRMED=true
#    4. Set PAPER_EXPLORATION_ENABLED=false
#    5. Provide BINANCE_API_KEY and BINANCE_API_SECRET
#    6. Review promotion_report for readiness
#    7. Manually start with VERY SMALL position/daily loss limits
#
# ✗ DO NOT use live trading until readiness conditions are met
# ✗ DO NOT enable all three guards simultaneously without review
