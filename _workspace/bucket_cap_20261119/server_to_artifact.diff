+def exploration_bucket_cap(env=None) -> int:
+    """PAPER_EXPLORE_MAX_OPEN_PER_BUCKET in [1, 7]; unset or invalid -> 2 (the old constant).
+
+    Invalid values fall back to the more restrictive default instead of raising in the
+    entry path; deploy_env_check.py refuses them before a deploy. Exact lookup, no int():
+    a very long digit string must not raise (review 2026-11-19).
+    """
+    raw = (os.environ if env is None else env).get("PAPER_EXPLORE_MAX_OPEN_PER_BUCKET", "")
+    return _EXPLORE_BUCKET_CAP_VALUES.get(str(raw).strip(), EXPLORE_BUCKET_CAP_DEFAULT)
+
+
+def _bucket_cap_for(bucket: Optional[str]) -> int:
+    return exploration_bucket_cap() if bucket == EXPLORE_BUCKET_CAP_BUCKET else EXPLORE_BUCKET_CAP_DEFAULT
